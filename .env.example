# Paste a newly generated Discord webhook URL here. Never commit your .env file.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Leave SEARCH_QUERY empty to monitor a filter-only Vinted search.
SEARCH_QUERY=
VINTED_BASE_URL=https://www.vinted.de
CATALOG_IDS=1242
SIZE_IDS=782,783,784,785,786,787,788,789,790
BRAND_IDS=53,1195,5977,283953,110434,383922,331974,15457,1775,14
CURRENCY=EUR
MIN_PRICE=2
MAX_PRICE=10
# How often Vinted is checked, in milliseconds.
RATE_LIMIT_MS=15000
